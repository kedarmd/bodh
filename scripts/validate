#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/validate [core|desktop|gui|profile]
  core     Runner regression tests, formatting, headless check/lint/tests (default)
  desktop  Core checks plus native GPUI check/lint/tests; no display needed
  gui      Build and run the interactive demo in release mode; display required
  profile  Build and run the native CPU redraw diagnostic in release mode
EOF
}

mode=${1:-core}
if [[ $# -gt 1 ]]; then usage >&2; exit 2; fi
case "$mode" in
  -h|--help) usage; exit 0 ;;
  core|desktop|gui|profile) ;;
  *) usage >&2; exit 2 ;;
esac

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd -- "$repo_root"
manifest="$repo_root/spikes/native-sequence/Cargo.toml"
trap 'status=$?; printf "Validation failed: mode=%s status=%s line=%s\n" "$mode" "$status" "$LINENO" >&2; exit "$status"' ERR

printf 'Validation mode: %s\n' "$mode"
revision=$(git rev-parse HEAD)
printf 'Revision: %s\n' "$revision"
working_tree=$(git status --porcelain --untracked-files=normal)
if [[ -n $working_tree ]]; then
  printf 'Working tree: dirty (results include local changes)\n'
else
  printf 'Working tree: clean\n'
fi
printf 'System: '; uname -srm
rustc --version
cargo --version
printf 'Application Cargo target: %s\n' "${CARGO_TARGET_DIR:-$repo_root/target}"
printf 'Spike Cargo target: %s\n' "${CARGO_TARGET_DIR:-$repo_root/spikes/native-sequence/target}"

case "$mode" in
  core|desktop)
    bash -n scripts/validate
    python3 -m unittest discover -s scripts/tests -v
    python3 -m unittest discover -s spikes/pr-capabilities -v
    python3 -m py_compile spikes/pr-capabilities/harness.py
    cargo fmt --manifest-path "$repo_root/Cargo.toml" --all --check
    cargo check --locked --manifest-path "$repo_root/Cargo.toml" --all-targets
    cargo clippy --locked --manifest-path "$repo_root/Cargo.toml" --all-targets -- -D warnings
    cargo test --locked --manifest-path "$repo_root/Cargo.toml"
    cargo fmt --manifest-path "$manifest" --all --check
    cargo check --locked --manifest-path "$manifest" --no-default-features --all-targets
    cargo clippy --locked --manifest-path "$manifest" --no-default-features --all-targets -- -D warnings
    cargo test --locked --manifest-path "$manifest" --no-default-features
    if [[ $mode == desktop ]]; then
      cargo check --locked --manifest-path "$manifest" --all-targets
      cargo clippy --locked --manifest-path "$manifest" --all-targets -- -D warnings
      cargo test --locked --manifest-path "$manifest"
    fi
    printf 'Validation passed: %s\n' "$mode"
    ;;
  gui|profile)
    printf 'Build mode: release; initial GPUI compilation can take several minutes.\n'
    if [[ $mode == profile ]]; then
      printf 'Measurement: native CPU redraw preparation; excludes physical input/GPU/compositor latency.\n'
      cargo run --release --locked --manifest-path "$manifest" -- --profile
    else
      cargo run --release --locked --manifest-path "$manifest"
    fi
    ;;
esac
